# Copy to jellyfin.env and fill in the values from "terraform output".
# No secrets are required: blob access uses the user assigned managed identity.

# Storage account created by Terraform (terraform output storage_account_name)
STORAGE_ACCOUNT_NAME=

# Blob container holding the video files (terraform output media_container_name)
MEDIA_CONTAINER_NAME=media

# Client ID of the user assigned managed identity
# (terraform output managed_identity_client_id)
AZURE_CLIENT_ID=

# Where the blob container is mounted inside the container
MEDIA_MOUNT_PATH=/media

# Local cache used by BlobFuse2
BLOBFUSE_TMP_PATH=/var/cache/blobfuse2

# Jellyfin state, all under the persisted /config Azure Files volume
JELLYFIN_CONFIG_DIR=/config/config
JELLYFIN_DATA_DIR=/config/data
JELLYFIN_CACHE_DIR=/config/cache
