[Unit]
Description=Persistent Jellyfin media disk (LUN 0)
# This is an application-time mount: initialization runs after sysinit.target.
# The normal mount Before=local-fs.target default would create a boot cycle.
DefaultDependencies=no
Requires=jellyfin-storage-init.service
After=local-fs.target jellyfin-storage-init.service
Conflicts=umount.target
Before=umount.target jellyfin.service caddy.service

[Mount]
What=/dev/disk/azure/scsi1/lun0
Where=/srv/jellyfin/media
Type=ext4
Options=defaults,nodev,nosuid,noexec
TimeoutSec=60
